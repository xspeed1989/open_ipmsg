# Maintainer: xspeed1989
# 从源码构建的 Arch 包（AUR 风格）。若只想用现成二进制打包，见 scripts/build-arch.sh
pkgname=open-ipmsg
pkgver=0.1.6
pkgrel=1
pkgdesc="局域网即时通讯客户端（IP Messenger 协议，UDP/TCP 2425）"
arch=('x86_64')
url="https://github.com/xspeed1989/open_ipmsg"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
makedepends=('git' 'rust' 'cargo' 'nodejs' 'pnpm')
optdepends=('libayatana-appindicator: 无 StatusNotifier 宿主时的托盘回退')
source=("$pkgname::git+https://github.com/xspeed1989/open_ipmsg.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname"
  pnpm install --frozen-lockfile
  # 必须走 tauri CLI：它会带上 tauri/custom-protocol，并先跑 beforeBuildCommand
  # 把前端产物生成到 dist/ 再编译。裸 cargo build --release 得到的是 dev 模式二进制：
  # 不内嵌前端资源，运行时加载 devUrl http://localhost:1420，装出来就是白屏。
  pnpm exec tauri build --no-bundle
}

check() {
  cd "$srcdir/$pkgname/src-tauri"
  cargo test --release --locked
  # 无头自检：完整跑一遍协议栈（发现/消息/文件/目录/回执）
  ./target/release/open-ipmsg --selftest
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 src-tauri/target/release/open-ipmsg "$pkgdir/usr/bin/open-ipmsg"
  # 桌面文件名必须等于 app id（tauri.conf.json 的 identifier）：KDE 用 systemd scope
  # app-<appid>-<随机>.scope 反推 portal app id，而 scope 名来自 .desktop 的 basename。
  # 若桌面文件仍用旧名（basename 为 open-ipmsg），portal 的正则会把 "open-" 当成
  # 启动器前缀解析出 "ipmsg"，找不到 ipmsg 的桌面文件就没有 app id，
  # GlobalShortcuts.CreateSession 直接 NotAllowed，安装版的 Wayland 全局热键
  # 被降级为禁用（tauri dev 下反而正常）。
  install -Dm644 packaging/linux/io.github.open-ipmsg.app.desktop \
    "$pkgdir/usr/share/applications/io.github.open-ipmsg.app.desktop"
  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/open-ipmsg.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/open-ipmsg.png"
  install -Dm644 src-tauri/icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/open-ipmsg.png"
}
